# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/neeiuta1/public_html/php/python"
PassengerBaseURI "/"
PassengerPython "/home/neeiuta1/virtualenv/public_html/php/python/3.8/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
RewriteEngine On
# Proteção de arquivos .ht*
<FilesMatch "^\.ht">
    Order allow,deny
    Deny from all
</FilesMatch>
# Desativar listagem de diretórios
Options -Indexes
# Redirecionar para HTTPS (se necessário)
# Descomente as linhas abaixo para forçar HTTPS
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Regras de reescrita de URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
# Permitir acesso a arquivos na pasta static
RewriteRule ^(static/.*)$ - [L]
# Regras para arquivos e diretórios não existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [L]
